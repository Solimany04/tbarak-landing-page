/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Keep the *.pages.dev hostnames out of search: the production alias and every
# preview deployment. Only https://tbarak.org should be indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# CMS admin (the HTML also carries <meta name="robots" content="noindex">).
/keystatic
  X-Robots-Tag: noindex, nofollow

/keystatic/*
  X-Robots-Tag: noindex, nofollow

# Arabic text in llms.txt needs an explicit charset.
/llms.txt
  Content-Type: text/plain; charset=utf-8

# Generated image variants (scripts/optimize-images.mjs) and Next's build
# output: every file name carries a content hash, so a changed file is a new
# URL and the old one can be cached for a year.
/_optimized/*
  Cache-Control: public, max-age=31536000, immutable

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted font files (lib/fonts.ts). Never edited in place: a new version
# of a face gets a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
