# ---------------------------------------------------------------------------
# Keystatic storage
#   dev  -> local  (edits write to ./content on your machine)
#   prod -> github (edits commit to the repo via a GitHub App; Vercel redeploys)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_KEYSTATIC_STORAGE_KIND=local

# --- Required ONLY when NEXT_PUBLIC_KEYSTATIC_STORAGE_KIND=github (production) ---
# Create these by running the app once with STORAGE_KIND=github and visiting
# /keystatic (it walks you through GitHub App creation), or make the App manually.
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=            # random 40+ char hex string (openssl rand -hex 32)

# ---------------------------------------------------------------------------
# Contact section CTA
#   The WhatsApp number behind the "Contact now" button in I_ContactSection.
#   Digits only, including the country code and no leading "+" or zeros,
#   e.g. 201234567890. Not a secret — it is inlined into the client bundle.
#   While unset the button renders but does not navigate.
#
#   NEXT_PUBLIC_* values are baked in at BUILD time and .env is never uploaded,
#   so for the deployed site this must also be set in
#   Vercel → Project → Settings → Environment Variables (Production, Preview,
#   Development) and the project redeployed. Changing it there requires a new
#   deployment to take effect.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=
